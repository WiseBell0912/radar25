clear; clc;

for main = 10 : 12
        clearvars -except main

%% Search
file_path = ['E:/png2019/',num2str(main), '/'];
%file_path = '/Users/limhyeonjong/Documents/Personal/GraduateProject/png2019/10/';
%file_path = 'E:/png2019/10/';
file_list = dir([file_path, '*.png']);

%% Information of Zone
modifiy_theta = pi * 5/3;

surf_theta1 = deg2rad(90);
surf_theta2 = deg2rad(160);
surf_center = 870 + 600/2;

wave_theta1 = deg2rad(90);
wave_theta2 = deg2rad(145);
wave_center = 1150 + 600/2;

energy_theta1 = deg2rad(100);
energy_theta2 = deg2rad(185);
energy_center = 1750 + 500/2;

%% input parameter
Nx = 201;
Ny = 201;
Nt = 128;

dx = 3;
dy = 3;
dt = 1.43;

Lx = 600;
Ly = 600;
Lt = Nt * dt;

g = 9.81;
h_surf = 15;
h_wave = 30;

%% Frequency
kx = -pi/dx : 2*pi/Lx : pi/dx;
ky = -pi/dy : 2*pi/Ly : pi/dy;
w  = -pi/dt : 2*pi/Lt : pi/dt;
w(65) = [];

[Kx, Ky, W] = meshgrid(ky, kx, w);
Kx = single(Kx);
Ky = single(Ky);
W  = single(W);
K  = sqrt(Kx.^2 + Ky.^2);

%% Windowing
window_xy = hann(Nx) * hann(Ny)';      % Nx x Ny
window_t  = hann(Nt);                  % Nt
window    = repmat(window_xy, 1, 1, Nt) .* reshape(window_t, 1, 1, Nt);

%% 하이패스 필터(HPF)용 마스크 미리 계산(반복문 밖)
hpK_surf = (K > 0.0156810355); % surf
hpK_wave = (K > 0.0111906701); % wave

hpW = (abs(W) > 2*pi*0.03);

hpMask_surf = hpW .* hpK_surf;
hpMask_wave = hpW .* hpK_wave;

%% 결과 저장용
nFile = length(file_list);

Date  = NaT(nFile,1);
LandE = zeros(nFile,1);
SurfE = zeros(nFile,1);
WaveE = zeros(nFile,1);

surf_SNR   = zeros(nFile,1);
surf_Ux    = zeros(nFile,1);
surf_Uy    = zeros(nFile,1);
surf_Tp   = zeros(nFile,1);
surf_Pdir = zeros(nFile,1);
surf_SpectrumMax = zeros(nFile,1);

wave_SNR   = zeros(nFile,1);
wave_Ux    = zeros(nFile,1);
wave_Uy    = zeros(nFile,1);
wave_Tp   = zeros(nFile,1);
wave_Pdir = zeros(nFile,1);
wave_SpectrumMax = zeros(nFile,1);

tic

parfor i = 1 : nFile

    %% 파일 읽기 및 Zone 추출
    png_path = fullfile(file_list(i).folder, file_list(i).name);
    dateStr  = file_list(i).name(5:end-4);
    dateVal  = datetime(dateStr, 'InputFormat', 'yyyyMMdd_HHmm');

    png_long = imread(png_path);
    png_long = png_long(1 : 512*1080*128);
    png_long = reshape(png_long, 512, 1080, 128);
    png_long = flip(png_long, 2);
    png_long = flip(png_long, 3);

    [png_surf, png_wave, png_energy] = f_extract_zone_new( ...
        png_long, modifiy_theta, ...
        surf_theta1, surf_theta2, surf_center, ...
        wave_theta1, wave_theta2, wave_center, ...
        energy_theta1, energy_theta2, energy_center);

    img_surf = single(png_surf);
    img_wave = single(png_wave);
    img_energy = single(png_energy);

    %% 이미지 변환
    img_surf = rot90(flip(flip(img_surf), 2));
    img_wave = rot90(flip(flip(img_wave), 2));
    img_energy = rot90(flip(flip(img_energy), 2));

    %% Energy
    % 저장
    SurfEVal = sum(img_surf, 'all');
    WaveEVal = sum(img_wave, 'all');
    LandEVal = sum(img_energy, 'all');

    %% FFT
    img_spectrum_surf_no_win = fftshift(abs(fftn(img_surf)).^2 / Nx^2 / Ny^2 / Nt^2);
    img_spectrum_surf = fftn(img_surf .* window);
    img_spectrum_surf = abs(img_spectrum_surf).^2 / Nx^2 / Ny^2 / Nt^2;
    img_spectrum_surf = fftshift(img_spectrum_surf);
    img_spectrum_surf_HP = img_spectrum_surf .* hpMask_surf;

    img_spectrum_wave_no_win = fftshift(abs(fftn(img_wave)).^2 / Nx^2 / Ny^2 / Nt^2);
    img_spectrum_wave = fftn(img_wave .* window);
    img_spectrum_wave = abs(img_spectrum_wave).^2 / Nx^2 / Ny^2 / Nt^2;
    img_spectrum_wave = fftshift(img_spectrum_wave);
    img_spectrum_wave_HP = img_spectrum_wave .* hpMask_wave;

    % 저장
    SpectrumMax_surfVal = max(img_spectrum_surf_HP(:));
    SpectrumMax_waveVal = max(img_spectrum_wave_HP(:));

    %% 유속 추정
    sigma_surf = sqrt(g .* K .* tanh(K .* h_surf));
    sigma_wave = sqrt(g .* K .* tanh(K .* h_wave));

    MTF_surf = (K.^(-1.21)) .* (W > 0) .* (img_spectrum_surf_HP > 1e-7 * max(img_spectrum_surf_HP(:)));
    MTF_surf(~isfinite(MTF_surf)) = 0;
    MTF_wave = (K.^(-1.21)) .* (W > 0) .* (img_spectrum_wave_HP > 1e-7 * max(img_spectrum_wave_HP(:)));
    MTF_wave(~isfinite(MTF_wave)) = 0;

    a1 = sum( img_spectrum_surf_HP .* MTF_surf .* Kx.^2 , 'all');
    a2 = sum( img_spectrum_surf_HP .* MTF_surf .* Ky.^2 , 'all');
    a3 = sum( img_spectrum_surf_HP .* MTF_surf .* Kx .* Ky , 'all');
    a4 = sum( img_spectrum_surf_HP .* MTF_surf .* (W - sigma_surf) .* Kx , 'all');
    a5 = sum( img_spectrum_surf_HP .* MTF_surf .* (W - sigma_surf) .* Ky , 'all');

    ux_surf = ( a2 * a4 - a3 * a5 ) / ( a1 * a2 - a3^2 );
    uy_surf = ( a1 * a5 - a3 * a4 ) / ( a1 * a2 - a3^2 );

    b1 = sum( img_spectrum_wave_HP .* MTF_wave .* Kx.^2 , 'all');
    b2 = sum( img_spectrum_wave_HP .* MTF_wave .* Ky.^2 , 'all');
    b3 = sum( img_spectrum_wave_HP .* MTF_wave .* Kx .* Ky , 'all');
    b4 = sum( img_spectrum_wave_HP .* MTF_wave .* (W - sigma_wave) .* Kx , 'all');
    b5 = sum( img_spectrum_wave_HP .* MTF_wave .* (W - sigma_wave) .* Ky , 'all');

    ux_wave = ( b2 * b4 - b3 * b5 ) / ( b1 * b2 - b3^2 );
    uy_wave = ( b1 * b5 - b3 * b4 ) / ( b1 * b2 - b3^2 );

    % 저장
    Ux_surfVal = ux_surf;
    Uy_surfVal = uy_surf;
    Ux_waveVal = ux_wave;
    Uy_waveVal = uy_wave;

    %% View
    for j = 1 : 1

        figure(1);
        set(gcf, 'Position', [0, 0, 1000, 1000]);
        tiledlayout(2, 2);

        nexttile;
        hold on;
        surf(img_surf(:, :, j), 'EdgeAlpha', 0);
        quiver3(101, 101, max(img_surf(:)) + 10, ux_surf, uy_surf, 0, 20, 'r', 'LineWidth', 2);
        hold off;
        view(0, 90);
        title('surf zone');

        nexttile;
        hold on;
        surf(sum(img_spectrum_surf_HP, 3), 'EdgeAlpha', 0);
        quiver3(101, 101, max(img_spectrum_surf_HP(:)) + 10, ux_surf, uy_surf, 0, 20, 'r', 'LineWidth', 2);
        hold off;
        view(0, 90);
        title(['Ux = ', num2str(round(ux_surf, 2)), ' & ', 'Uy = ', num2str(round(uy_surf, 2))]);

        nexttile;
        hold on;
        surf(img_wave(:, :, j), 'EdgeAlpha', 0);
        quiver3(101, 101, max(img_wave(:)) + 10, ux_wave, uy_wave, 0, 20, 'r', 'LineWidth', 2);
        hold off;
        view(0, 90);
        title('wave zone');

        nexttile;
        hold on;
        surf(sum(img_spectrum_wave_HP, 3), 'EdgeAlpha', 0);
        quiver3(101, 101, max(img_spectrum_wave_HP(:)) + 10, ux_wave, uy_wave, 0, 20, 'r', 'LineWidth', 2);
        hold off;
        view(0, 90);
        title(['Ux = ', num2str(round(ux_wave, 2)), ' & ', 'Uy = ', num2str(round(uy_wave, 2))]);

    end

    %% BPF
    bpv = 8 * (2*pi/Lt);

    bpMask_surf = (sqrt( g .* K .* tanh( K .* h_surf ) ) + (Kx .* ux_surf) + (Ky .* uy_surf) - bpv <= abs(W)) & (abs(W) <= sqrt( g .* K .* tanh( K .* h_surf ) ) + (Kx .* ux_surf) + (Ky .* uy_surf) + bpv);
    bpMask_wave = (sqrt( g .* K .* tanh( K .* h_wave ) ) + (Kx .* ux_wave) + (Ky .* uy_wave) - bpv <= abs(W)) & (abs(W) <= sqrt( g .* K .* tanh( K .* h_wave ) ) + (Kx .* ux_wave) + (Ky .* uy_wave) + bpv);

    img_spectrum_surf_BP = img_spectrum_surf_HP .* bpMask_surf;
    img_spectrum_wave_BP = img_spectrum_wave_HP .* bpMask_wave;

    %% SNR
    signal_surf = sum(img_spectrum_surf_BP, 'all');
    noise_surf = sum(img_spectrum_surf_no_win, 'all') - signal_surf;

    signal_wave = sum(img_spectrum_wave_BP, 'all');
    noise_wave = sum(img_spectrum_wave_no_win, 'all') - signal_wave;

    % 저장
    SNR_surfVal = signal_surf / noise_surf;
    SNR_waveVal = signal_wave / noise_wave;

    %% Tp
    img_spectrum_surf_W = squeeze(sum(sum(img_spectrum_surf_BP .* (W > 0), 1), 2));
    [~, maxidx_surf_Tp] = max(img_spectrum_surf_W);
    [~, sorted_idx_surf] = sort(img_spectrum_surf_W, 'descend');

    img_spectrum_wave_W = squeeze(sum(sum(img_spectrum_wave_BP .* (W > 0), 1), 2));
    [~, maxidx_wave_Tp] = max(img_spectrum_wave_W);
    [~, sorted_idx_wave] = sort(img_spectrum_wave_W, 'descend');

    % 저장
    Tp_surfVal = 2 * pi / w(sorted_idx_surf(1:2));
    Tp_waveVal = 2 * pi / w(sorted_idx_surf(1:2));

    %% Pdir
    img_spectrum_surf_K = sum(img_spectrum_surf_BP, 3) .* (Ky(:, :, 1) > 0);
    [~, maxidx_surf_Pdir] = max(img_spectrum_surf_K, [], "all");
    [~, sorted_idx_surf] = sort(img_spectrum_surf_K(:), 'descend');
    
    img_spectrum_wave_K = sum(img_spectrum_wave_BP, 3) .* (Ky(:, :, 1) > 0);
    [~, maxidx_wave_Pdir] = max(img_spectrum_wave_K, [], "all");
    [~, sorted_idx_wave] = sort(img_spectrum_wave_K(:), 'descend');
    
    % 저장
    Pdir_surfVal = mean(rad2deg(atan2(Ky(sorted_idx_surf(1:5)), Kx(sorted_idx_surf(1:5)))));
    Pdir_waveVal = mean(rad2deg(atan2(Ky(sorted_idx_wave(1:5)), Kx(sorted_idx_wave(1:5)))));

    %% 최종 저장
    Date(i)  = dateVal;
    LandE(i) = LandEVal;
    SurfE(i) = SurfEVal;
    WaveE(i) = WaveEVal;

    surf_SNR(i)   = SNR_surfVal;
    surf_Ux(i)    = Ux_surfVal;
    surf_Uy(i)    = Uy_surfVal;
    surf_Tp(i)   = Tp_surfVal;
    surf_Pdir(i) = Pdir_surfVal;
    surf_SpectrumMax(i) = SpectrumMax_surfVal;
    
    wave_SNR(i)   = SNR_waveVal;
    wave_Ux(i)    = Ux_waveVal;
    wave_Uy(i)    = Uy_waveVal;
    wave_Tp(i)   = Tp_waveVal;
    wave_Pdir(i) = Pdir_waveVal;
    wave_SpectrumMax(i) = SpectrumMax_waveVal;

    %% 확인
    disp([num2str(i) '/' num2str(main)]);
    disp(['surf SNR = ', num2str(surf_SNR(i))]);
    disp(['wave SNR = ', num2str(wave_SNR(i))]);

end

save(['snr_y19', num2str(main), '_0412.mat'], 'Date', 'LandE', 'SurfE', 'WaveE', 'surf_Pdir', 'surf_SNR', 'surf_Tp', 'surf_Ux', 'surf_Uy', 'surf_SpectrumMax', 'wave_Pdir', 'wave_SNR', 'wave_Tp', 'wave_Ux', 'wave_Uy', 'wave_SpectrumMax');

end
toc

system('shutdown -s -t 300');  % 60초 후 자동 종료